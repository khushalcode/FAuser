{
  "expo": {
    "name": "Food Munch",
    "slug": "food-munch-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "foodmunch",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodmunch.customer",
      "config": {
        "googleMapsApiKey": "AIzaSyBz4h_RTdZxvCr4Tw7lkc5us6A9cCS_Gbc"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.foodmunch.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "NOTIFICATIONS",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBz4h_RTdZxvCr4Tw7lkc5us6A9cCS_Gbc"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Food Munch to use your location for delivery."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F0F0F",
          "defaultChannel": "orders",
          "androidIcons": [
            {
              "name": "ic_stat_foodmunch",
              "foregroundImage": "./assets/adaptive-icon.png"
            }
          ]
        }
      ],
      "./plugins/google-maps-plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "food-munch-customer"
      },
      "firebase": {
        "apiKey": "AIzaSyBZg4Fiejg7Kx3Dulke4BFg_RbwZTSYd-g",
